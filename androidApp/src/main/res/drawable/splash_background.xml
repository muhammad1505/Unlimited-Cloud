<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Brand gradient behind the very first frame, before Compose draws. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#FF1E1B4B"
                android:endColor="#FF0E7490"
                android:startColor="#FF0B1220"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:width="144dp"
        android:height="144dp"
        android:drawable="@drawable/ic_brand_mark"
        android:gravity="center" />
</layer-list>
