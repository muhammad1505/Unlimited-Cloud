<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only these two are needed. Files are reached through the Storage Access
         Framework, so no storage permission is declared.
         scripts/check-apk-permissions.py reads the built APK and fails if a
         storage/media permission or a privileged marker appears, even when a
         dependency merges it in. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- One notification when a transfer finishes or fails. Requested at runtime
         on Android 13+; refusing it only silences that notification, the in-app
         banner keeps working. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A transfer batch keeps the process alive in a dataSync foreground service.
         Without it, removing the app from recents killed the process mid-upload,
         which left its progress notification stranded in the shade. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android 11+ hides other packages from the app. The battery card opens the
         manufacturer's autostart screen by component name, which only resolves for
         packages listed here; without this the shortcut silently looked unsupported. -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.asus.mobilemanager" />
        <package android:name="com.meizu.safe" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnlimitedCloud">

        <activity
            android:name="com.unlimitedcloud.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Holds the process while a batch runs and reuses the notifier's ongoing
             notification, so it disappears together with the service. -->
        <service
            android:name="com.unlimitedcloud.platform.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- WorkManager's diagnostics receiver and profileinstaller's receiver
             carry android:permission="android.permission.DUMP". They request no
             permission, but a manifest scanner sees the privileged marker. Neither
             is needed in a release build: diagnostics are an adb-only tool, and
             the baseline profile is still installed by ProfileInstaller. -->
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />

        <!-- Share sheet: exposes only the copied file in cache/shared, never the
             TDLib database or the rest of app storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
